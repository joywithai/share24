# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# Local development uses the embedded PostgreSQL started by `npm run db:dev`
# (port 5433). In production this is Supabase.
DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:5433/corium?schema=public"

# Supabase — app traffic goes through the *transaction pooler* (port 6543).
#
#   DATABASE_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true&sslmode=require"
#   DIRECT_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=require"
#
# `DIRECT_URL` is the *session* pooler: migrations need a real session, and
# every Prisma CLI command prefers this URL when it is set (see
# prisma.config.ts — Prisma 7 has no `directUrl` in the schema). On a fresh
# Supabase project, run `npm run db:deploy` once to create the schema.
#
# `sslmode=require` is not optional: node-postgres — the driver under the
# Prisma adapter — only starts TLS when the URL asks for it, and Supabase
# refuses unencrypted connections. Neither host is the IPv6-only
# `db.<ref>.supabase.co` address, which many networks cannot reach.
DIRECT_URL=""

# Random 32+ byte hex — Better Auth session cookies, unlock-token HMAC.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
BETTER_AUTH_SECRET="replace-me-with-a-random-32-byte-hex"

# Optional: separate secret for the per-route PIN "unlock" cookie HMAC.
# Falls back to BETTER_AUTH_SECRET when unset.
UNLOCK_SECRET="replace-me-with-another-random-hex"

# Public URL of the app (Better Auth cookie scoping). Leave empty locally.
NEXT_PUBLIC_APP_URL=""

# ---------------------------------------------------------------------------
# File storage
# ---------------------------------------------------------------------------
# Where uploaded files are written. Defaults to /tmp/corium-uploads.
# Locally a folder inside the project is friendlier — it sits next to the
# database data, so a dev-server restart cannot sweep the files away.
CORIUM_UPLOADS_DIR="./.uploads"

# Where *new* uploads go: LOCAL (default), R2 or B2.
# Existing shares keep downloading from wherever they were written, so flipping
# this never breaks files that are already up.
STORAGE_TYPE="LOCAL"

# Backblaze B2 — read only when STORAGE_TYPE=B2 (or a row says B2).
# Endpoint and region must match the bucket's own region; the scheme may be
# left off (`s3.us-east-005.backblazeb2.com`) or given in full
# (`http://127.0.0.1:9000` for an S3-compatible server on a private network).
# B2_FORCE_PATH_STYLE=true is implied for localhost endpoints.
B2_ENDPOINT="s3.us-east-005.backblazeb2.com"
B2_KEY_ID=""
B2_APPLICATION_KEY=""
B2_BUCKET_NAME=""
B2_REGION="us-east-005"
B2_FORCE_PATH_STYLE=""

# Cloudflare R2 — read only when STORAGE_TYPE=R2 (or a row says R2).
# Account id, an API token with Object Read & Write on the bucket, and the
# bucket name. The endpoint is derived: https://<account id>.r2.cloudflarestorage.com
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET_NAME=""

# ---------------------------------------------------------------------------
# Rate limiting
# ---------------------------------------------------------------------------
# Optional — rate limiting shared across instances.
#
# Without these, limits are per-process (correct for a single instance, and
# what local development uses). With an Upstash Redis database the counters are
# shared, which is what a serverless deployment needs: two lambdas cannot see
# each other's memory. Configured-but-unreachable is survivable — a request
# falls back to the in-memory window after a short timeout instead of failing.
#
# The windows themselves live in lib/security/rate-limit.ts (`RATE_LIMITS`) and
# are named in lib/rate-limit/index.ts: createShare 10/hour, uploadFile
# 20/hour, verifyPin 5/minute per address + route, download 30/hour, login
# 5/15 minutes.
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# ---------------------------------------------------------------------------
# Operations
# ---------------------------------------------------------------------------
# Optional — secret for the scheduled cleanup endpoint (/api/cron/cleanup).
# Vercel Cron sends it automatically as `Authorization: Bearer $CRON_SECRET`
# when the variable is set. Without it, only a signed-in administrator can run
# the job.
CRON_SECRET=""

# Optional — reverse-proxy tuning (leave both empty unless you need them).
# Comma-separated public origins allowed to post to Server Actions even when
# the proxy rewrites the Host header (Next.js CSRF check). Wildcards allowed.
CORIUM_ALLOWED_ORIGINS=""
# Comma-separated extra origins accepted by Better Auth's CSRF/origin check
# (on top of NEXT_PUBLIC_APP_URL, or the request's own host when it is unset).
CORIUM_TRUSTED_ORIGINS=""
